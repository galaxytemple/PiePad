{
  "name": "piepad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @piepad/web dev",
    "dev:ws": "pnpm --filter @piepad/ws dev",
    "dev:cleanup": "pnpm --filter @piepad/cleanup dev",
    "cleanup:once": "pnpm --filter @piepad/cleanup run:once",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dc": "./scripts/dc",
    "db:migrate": "./scripts/dc --profile tools run --rm flyway migrate",
    "db:info": "./scripts/dc --profile tools run --rm flyway info",
    "db:validate": "./scripts/dc --profile tools run --rm flyway validate",
    "piston:up": "./scripts/dc --profile runtime up -d piston",
    "piston:down": "./scripts/dc --profile runtime down",
    "piston:install": "./scripts/install-piston-langs.sh",
    "piston:logs": "docker logs -f piepad-piston"
  }
}
