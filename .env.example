# --- Public access ---
# Your OCI instance public IP, e.g. 132.226.10.20
PUBLIC_IP=
# Derived host: <ip-with-dashes>.sslip.io, e.g. 132-226-10-20.sslip.io
PUBLIC_HOST=

# --- Oracle Autonomous Database (mTLS) ---
# Login user. Production splits login user from table-owner schema for
# least privilege (e.g. APP_PROD_USER for the app, APP_PROD_SCHEMA owns
# the tables). For local dev where you own everything, just put your own
# schema here and leave ORACLE_SCHEMA empty.
ORACLE_USER=
ORACLE_PASSWORD=
# TNS alias from tnsnames.ora inside the wallet (e.g. piepad_tp, piepad_high)
ORACLE_TNS_NAME=
# Optional: pin CURRENT_SCHEMA when ORACLE_USER is *not* the table owner.
# packages/db's withConnection() runs ALTER SESSION SET CURRENT_SCHEMA so
# unqualified table names in app SQL resolve into the owner schema.
# Leave empty when login user owns its own tables.
ORACLE_SCHEMA=
# Path to the extracted wallet directory inside containers (do not change)
ORACLE_WALLET_DIR=/wallet
# Wallet password set when the ADB wallet zip was downloaded from OCI.
# Required for node-oracledb Thin mode (it cannot use cwallet.sso directly).
ORACLE_WALLET_PASSWORD=

# Note: FLYWAY_URL / FLYWAY_USER / FLYWAY_PASSWORD are composed automatically
# by docker-compose.yml from the ORACLE_* values above. Do not set them here.
# CI does NOT run flyway migrate — schema changes are applied locally with
# DDL-capable credentials. The runtime ORACLE_USER intentionally lacks DDL.

# --- Auth (Auth.js v5 + Google) ---
# Random 32+ bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# (and add https://<PUBLIC_HOST>/api/auth/callback/google for prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required when running behind a reverse proxy (Caddy in prod). Without
# this, Auth.js v5 throws UntrustedHost on every auth() call and the
# /login ↔ / redirect logic loops with ERR_TOO_MANY_REDIRECTS.
AUTH_TRUST_HOST=true
# Canonical public URL — pins OAuth callback / signin / error redirects.
# Without it, Auth.js falls back to the container listen address
# (0.0.0.0:3000) when forwarded host parsing misses.
# Local dev: http://localhost:3000  (or leave unset)
# Prod:      https://${PUBLIC_HOST}
AUTH_URL=http://localhost:3000
# Comma-separated emails. Effective admin = email in this list. There is
# no DB column or in-app admin signup.
ADMIN_EMAILS=

# bcrypt rounds for room passwords.
BCRYPT_ROUNDS=12

# --- WebSocket ---
WS_PORT=1234
# Public WSS endpoint exposed via Caddy: wss://${PUBLIC_HOST}/yjs
WS_PUBLIC_PATH=/yjs

# --- Piston (code execution) ---
# This is the API root — /api/run appends "/execute" itself.
#   self-hosted dev (host):       http://127.0.0.1:2000/api/v2
#   self-hosted compose internal: http://piston:2000/api/v2
#   self-hosted dedicated VM:     http://<piston-host>:2000/api/v2
# The public emkc.org endpoint became whitelist-only on 2026-02-15 and is
# no longer a viable option — self-host is the only path forward.
PISTON_URL=http://127.0.0.1:2000/api/v2

# Per-IP rate limit for /api/run (Phase 7 will switch to Redis).
RUN_RATE_LIMIT_PER_MINUTE=10
# Hard timeout — Piston SIGKILLs the process at this point. 10s default.
# Note: when PISTON_URL points at emkc.org, /api/run clamps both timeouts
# to 3000ms because the public API rejects anything higher.
RUN_TIMEOUT_MS=10000
# Compile-step timeout for compiled languages (java, c++, ...).
COMPILE_TIMEOUT_MS=10000

# --- WebSocket (client) ---
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# Server-to-server URL the Next.js process uses to call apps/ws's internal
# endpoints (eviction etc). Auth is the shared AUTH_SECRET above.
# Dev: http://127.0.0.1:1234 — container: http://piepad-ws:1234
WS_INTERNAL_URL=http://127.0.0.1:1234

# --- Snapshots ---
SNAPSHOT_INTERVAL_MS=30000

# --- Cleanup (apps/cleanup) ---
# Rooms idle for this many days are deleted, with audit row in
# room_deletions and LevelDB cleared via the ws /internal/evict endpoint.
ROOM_TTL_DAYS=30
# Cron expression in UTC. Default: every day at 03:00 UTC.
CLEANUP_CRON=0 3 * * *
# Set to "false" to suppress the catch-up sweep at container start.
CLEANUP_RUN_ON_START=true

# --- Quiz (System Design Quiz) ---
# Separate DB user credentials if Quiz has its own schema/user on the Oracle ADB.
# If left blank, falls back to ORACLE_USER / ORACLE_PASSWORD / ORACLE_SCHEMA.
QUIZ_ORACLE_USER=
QUIZ_ORACLE_PASSWORD=
QUIZ_ORACLE_SCHEMA=
# Email of the quiz owner (who has access to /quiz and /quiz-settings)
QUIZ_OWNER_EMAIL=galaxytemple@gmail.com
