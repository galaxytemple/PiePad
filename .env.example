# --- Public access ---
# Your OCI instance public IP, e.g. 132.226.10.20
PUBLIC_IP=
# Derived host: <ip-with-dashes>.sslip.io, e.g. 132-226-10-20.sslip.io
PUBLIC_HOST=

# --- Oracle Autonomous Database (mTLS) ---
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
# TNS alias from tnsnames.ora inside the wallet (e.g. piepad_tp, piepad_high)
ORACLE_TNS_NAME=
# Path to the extracted wallet directory inside containers (do not change)
ORACLE_WALLET_DIR=/wallet
# Wallet password set when the ADB wallet zip was downloaded from OCI.
# Required for node-oracledb Thin mode (it cannot use cwallet.sso directly).
ORACLE_WALLET_PASSWORD=

# Note: FLYWAY_URL / FLYWAY_USER / FLYWAY_PASSWORD are composed automatically
# by docker-compose.yml from the ORACLE_* values above. Do not set them here.

# --- Auth (Auth.js v5 + Google) ---
# Random 32+ bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails. Effective admin = email in this list.
ADMIN_EMAILS=

# bcrypt rounds for room passwords.
BCRYPT_ROUNDS=12

# --- WebSocket ---
WS_PORT=1234
# Public WSS endpoint exposed via Caddy: wss://${PUBLIC_HOST}/yjs
WS_PUBLIC_PATH=/yjs

# --- Piston (self-hosted code execution) ---
# Dev (host running pnpm dev:web): http://127.0.0.1:2000
#   ^ NOT localhost — Node 17+ resolves localhost to ::1 first, but Docker
#     Desktop only forwards IPv4, so localhost fails fast with ECONNREFUSED.
# Container (web service in compose): http://piston:2000
PISTON_URL=http://127.0.0.1:2000

# Per-IP rate limit for /api/run (Phase 7 will switch to Redis).
RUN_RATE_LIMIT_PER_MINUTE=10
# Hard timeout — Piston SIGKILLs the process at this point. 10s default.
RUN_TIMEOUT_MS=10000
# Compile-step timeout for compiled languages (java, c++, ...).
COMPILE_TIMEOUT_MS=10000

# --- WebSocket (client) ---
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# Server-to-server URL the Next.js process uses to call apps/ws's internal
# endpoints (eviction etc). Auth is the shared AUTH_SECRET above.
# Dev: http://127.0.0.1:1234 — container: http://piepad-ws:1234
WS_INTERNAL_URL=http://127.0.0.1:1234

# --- Snapshots ---
SNAPSHOT_INTERVAL_MS=30000
ROOM_TTL_DAYS=30
