#!/usr/bin/env bash
# Shorthand for the project's docker compose invocation.
# Always loads the project-root .env and points at docker/docker-compose.yml,
# so callers don't have to remember --env-file / -f flags every time.
#
# Usage examples:
#   ./scripts/dc up -d                  # default profile (caddy/web/ws/cleanup)
#   ./scripts/dc --profile runtime up -d piston
#   ./scripts/dc --profile tools run --rm flyway info
#   ./scripts/dc logs -f web
#   ./scripts/dc build cleanup

set -euo pipefail

# Resolve docker via PATH but fall back to /usr/bin/docker, because:
#   - non-interactive SSH sessions sometimes have a stripped PATH
#   - cwd will hold a `docker/` directory after the cd below, and an empty
#     PATH entry would make `exec docker` resolve to that directory, not
#     the binary, with the cryptic "Is a directory" error.
DOCKER_BIN="$(command -v docker || echo /usr/bin/docker)"

cd "$(dirname "$0")/.."
exec "$DOCKER_BIN" compose --env-file .env -f docker/docker-compose.yml "$@"
