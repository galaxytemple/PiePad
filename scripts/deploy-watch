#!/usr/bin/env bash
#
# Watch the GitHub Actions deploy run for a specific commit SHA (default: HEAD).
# Avoids the "latest run != the commit I just pushed" race — it polls until the
# run whose headSha matches appears, then streams it to completion.
#
# Usage:
#   scripts/deploy-watch            # watch the deploy for HEAD
#   scripts/deploy-watch <sha>      # watch the deploy for a specific commit
#
# Requires: gh (authenticated).

set -euo pipefail

SHA="${1:-$(git rev-parse HEAD)}"
SHORT="${SHA:0:7}"
echo "Waiting for the deploy run matching ${SHORT}…"

RUN_ID=""
for _ in $(seq 1 30); do
  RUN_ID=$(gh run list --workflow=deploy.yml --limit 20 \
    --json databaseId,headSha \
    --jq ".[] | select(.headSha == \"${SHA}\") | .databaseId" | head -1)
  [ -n "${RUN_ID}" ] && break
  sleep 6
done

if [ -z "${RUN_ID}" ]; then
  echo "::error:: no deploy run found for ${SHORT} after ~3 min" >&2
  exit 1
fi

echo "Found run ${RUN_ID} for ${SHORT} — watching…"
exec gh run watch "${RUN_ID}" --interval 20 --exit-status
